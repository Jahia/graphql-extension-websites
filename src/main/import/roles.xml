<?xml version="1.0" encoding="UTF-8"?>
<!--
  SEC-136. The server role below deliberately does NOT carry `websitesDelete`.

  It is granted at the JCR root, and JCR permissions inherit down the tree, so any permission
  listed here is held on every node — including every site. Adding `websitesDelete` here would
  make the per-site check in deleteSiteByKey pass everywhere and reinstate the vulnerability.

  Site deletion is delegated instead through `graphql-extension-websites-site-administrator`,
  which is granted per site on /sites/<siteKey>. The same reasoning applies to `websitesExport`
  as of §4.3: exporting a named site is target-scoped, so that permission also lives only on the
  site role.

  §4.3 — the server role no longer carries `jcr:read_default`. It was never needed to reach the
  API (verified on a live instance: a user holding only `graphqlAdminMutation` + `websitesCreate`
  can call createSiteByKey), but because the role is granted at `/` and JCR permissions inherit
  downward, it gave every holder read over the entire repository. That is what made the
  "exportAllSites is bounded by the caller's read rights" claim vacuous for this role.

  Read is now granted only where it is actually needed: on the site role, scoped to the site it
  is granted on, so exportWebsite produces a real archive for a site administrator and nothing
  for anyone else.
-->
<roles jcr:primaryType="jnt:roles"
       xmlns:jcr="http://www.jcp.org/jcr/1.0"
       xmlns:j="http://www.jahia.org/jahia/1.0"
       xmlns:jnt="http://www.jahia.org/jahia/nt/1.0">

    <graphql-extension-websites-administrator jcr:primaryType="jnt:role"
                                              j:nodeTypes="rep:root"
                                              j:roleGroup="server-role"
                                              j:permissionNames="graphqlAdminMutation websitesAdmin websitesCreate websitesExportAll"
                                              j:privilegedAccess="true">
        <j:translation_en jcr:primaryType="jnt:translation"
                          jcr:language="en"
                          jcr:title="GraphQL Extension Websites administrator"
                          jcr:description="Grants access to the website lifecycle GraphQL mutations (create, export, import) without requiring full server administrator rights. Does NOT grant site deletion: to delegate deletion of a specific site, grant the 'GraphQL Extension Websites site administrator' role on that site. To delegate a narrower subset, build a custom role from the individual websitesCreate / websitesExport / websitesExportAll permissions instead of granting this one."/>
    </graphql-extension-websites-administrator>

    <graphql-extension-websites-site-administrator jcr:primaryType="jnt:role"
                                                   j:nodeTypes="jnt:virtualsite"
                                                   j:roleGroup="site-role"
                                                   j:permissionNames="jcr:read_default websitesDelete websitesExport"
                                                   j:privilegedAccess="true">
        <j:translation_en jcr:primaryType="jnt:translation"
                          jcr:language="en"
                          jcr:title="GraphQL Extension Websites site administrator"
                          jcr:description="Grants export and deletion of the site this role is granted on, through the exportWebsite and deleteSiteByKey GraphQL mutations. Grant it per site; the holder also needs the server-level 'GraphQL Extension Websites administrator' role to reach the API. Includes read on the site, which exportWebsite needs to produce a non-empty archive."/>
    </graphql-extension-websites-site-administrator>
</roles>
