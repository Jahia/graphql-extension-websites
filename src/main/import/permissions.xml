<?xml version="1.0" encoding="UTF-8"?>
<!--
  SEC-136: `websitesDelete` and `websitesExport` MUST stay SIBLINGS of `websitesAdmin`, never
  children of it.

  Jahia registers nested permission nodes as aggregated sub-privileges of their parent
  (JahiaPrivilegeRegistry.registerPrivileges -> new PrivilegeImpl(..., subPrivileges, ...)),
  so holding a permission implicitly grants everything nested beneath it. Nesting
  `websitesDelete` under `websitesAdmin` would hand it straight back to every holder of the
  root-granted `graphql-extension-websites-administrator` role — i.e. it would look like a
  permission split while changing nothing.

  Both are children of `admin`, which is deliberate: a full server administrator holds `admin`
  at the repository root and therefore aggregates both, so site deletion keeps working for
  administrators without a special case in the code.
-->
<permissions xmlns:jcr="http://www.jcp.org/jcr/1.0">
    <admin jcr:primaryType="jnt:permission">
        <!-- Coarse entry gate, checked at "/". Retained on the three mutations whose real
             authorization lives in the method body: deleteSiteByKey and exportWebsite (both
             target-scoped, see websitesDelete / websitesExport) and importWebsite
             (server-administrator gate). None of the three can be gated by a finer permission
             at the annotation level — see the note below. -->
        <websitesAdmin jcr:primaryType="jnt:permission"/>

        <!-- Per-operation gates, each checked at "/" by @GraphQLRequiresPermission on its own
             mutation. Splitting these lets an operator delegate site creation without also
             delegating a bulk instance export, and so on. These two, together with the
             `websitesAdmin` gate above, are the permissions that are safe to grant at the
             repository root — and the only ones the shipped server role carries. -->
        <websitesCreate jcr:primaryType="jnt:permission"/>
        <websitesExportAll jcr:primaryType="jnt:permission"/>

        <!-- Target-scoped gates: may export / delete THIS site. Checked by
             WebsitesAdminMutation.exportWebsite and .deleteSiteByKey against the target site
             node in the caller's own session, NOT at "/". Deliberately absent from the
             root-granted server role; carried by the site-scoped role in roles.xml.

             This is why those two mutations' annotations stay `websitesAdmin` rather than
             becoming `websitesExport` / `websitesDelete`: the annotation is evaluated at the
             repository root, so annotating them with a permission that is intentionally never
             granted at the root would deny the site-scoped holder before the body could run. -->
        <websitesExport jcr:primaryType="jnt:permission"/>
        <websitesDelete jcr:primaryType="jnt:permission"/>
    </admin>
</permissions>
