<?xml version="1.0" encoding="UTF-8"?>
<!--
  SEC-136: `websitesDelete` MUST stay a SIBLING of `websitesAdmin`, never a child of it.

  Jahia registers nested permission nodes as aggregated sub-privileges of their parent
  (JahiaPrivilegeRegistry.registerPrivileges -> new PrivilegeImpl(..., subPrivileges, ...)),
  so holding a permission implicitly grants everything nested beneath it. Nesting
  `websitesDelete` under `websitesAdmin` would hand it straight back to every holder of the
  root-granted `graphql-extension-websites-administrator` role — i.e. it would look like a
  permission split while changing nothing.

  Both are children of `admin`, which is deliberate: a full server administrator holds `admin`
  at the repository root and therefore aggregates both, so site deletion keeps working for
  administrators without a special case in the code.
-->
<permissions xmlns:jcr="http://www.jcp.org/jcr/1.0">
    <admin jcr:primaryType="jnt:permission">
        <!-- Coarse entry gate, checked at "/". Retained on the two mutations whose real
             authorization lives in the method body: deleteSiteByKey (target-scoped, see
             websitesDelete) and importWebsite (server-administrator gate). Those two cannot be
             gated by a finer permission at the annotation level — see the note below. -->
        <websitesAdmin jcr:primaryType="jnt:permission"/>

        <!-- Per-operation gates, each checked at "/" by @GraphQLRequiresPermission on its own
             mutation. Splitting these lets an operator delegate site creation without also
             delegating a bulk instance export, and so on. -->
        <websitesCreate jcr:primaryType="jnt:permission"/>
        <websitesExport jcr:primaryType="jnt:permission"/>
        <websitesExportAll jcr:primaryType="jnt:permission"/>

        <!-- Target-scoped gate: may delete THIS site. Checked by
             WebsitesAdminMutation.deleteSiteByKey against the target site node in the caller's
             own session, NOT at "/". Deliberately absent from the root-granted server role;
             carried by the site-scoped role in roles.xml.

             This is why deleteSiteByKey's annotation stays `websitesAdmin` rather than becoming
             `websitesDelete`: the annotation is evaluated at the repository root, so annotating
             it with a permission that is intentionally never granted at the root would deny the
             site-scoped holder before the body could run. -->
        <websitesDelete jcr:primaryType="jnt:permission"/>
    </admin>
</permissions>
